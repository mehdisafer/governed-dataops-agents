FROM python:3.12.14-slim-trixie@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f AS download
COPY scripts/bootstrap_runtime.py /bootstrap_runtime.py
RUN python /bootstrap_runtime.py --component temporal --destination /runtime

FROM python:3.12.14-slim-trixie@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f
COPY --from=download /runtime/temporal /opt/temporal
RUN mkdir /data && chown 1000:1000 /data
USER 1000:1000
ENTRYPOINT ["/opt/temporal/temporal"]
CMD ["server", "start-dev", "--ip", "0.0.0.0", "--port", "7233", "--ui-ip", "0.0.0.0", "--ui-port", "8233", "--ui-disable-news-fetch", "--metrics-port", "8234", "--db-filename", "/data/temporal.db"]
